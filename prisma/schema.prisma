// prisma\schema.prisma
// JavaScript Fluency System — Prisma Schema (Draft v1)
// Single-user app — no User model needed; a single bearer token gates all API access.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TopicStatus {
  GREEN
  YELLOW
  RED
}

enum ConfidenceLevel {
  EASY
  OKAY
  DIFFICULT
  DIDNT_UNDERSTAND
}

enum SessionType {
  REVISION
  PRACTICE
}

enum QuestionFormat {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  OUTPUT_PREDICTION
  CODE_WRITING
  DEBUGGING
}

enum RevisionSessionStatus {
  OPEN
  COMPLETED
}

enum RevisionSessionOutcome {
  ADVANCE
  REINFORCE
  REINFORCE_AT_1
  RESET
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model Topic {
  id          String      @id @default(cuid())
  name        String      @unique                      // e.g. "Closures"
  slug        String      @unique                      // e.g. "closures" (for URL)
  area        String      @default("JavaScript")       // JavaScript, TypeScript, Angular, Node.js... (spec §14)
  category    String                                   // Fundamentals | Core | Asynchronous | Advanced (spec §13)

  status      TopicStatus @default(RED)                // spec §7
  intervalDays Int        @default(1)                  // current step in 1/3/7/14/30 (spec §6)
  nextRevisionDate DateTime @default(now())

  questions         Question[]
  logs              SessionLog[]
  mistakes          Mistake[]
  deepDiveNote      DeepDiveNote?
  revisionSessions  RevisionSession[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([nextRevisionDate])
  @@index([status])
}

model Question {
  id            String          @id @default(cuid())
  topicId       String
  topic         Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)

  sessionType   SessionType                              // REVISION (commute-mode) or PRACTICE (laptop-mode) — spec §5, §16
  format        QuestionFormat
  prompt        String                                    // question / task text
  options       Json?                                     // for MULTIPLE_CHOICE: array of choice strings
  correctAnswer String?                                    // correct option id, or reference answer/code
  explanation   String?                                    // shown after answering — spec §10
  codeSnippet   String?                                  // for CODE_WRITING or DEBUGGING questions
  logs          SessionLog[]
  sessionQuestions RevisionSessionQuestion[]
  mistakes      Mistake[]

  createdAt     DateTime        @default(now())

  @@index([topicId, sessionType])
}

// One row per answered question — covers both "Revision History" and
// "Practice History" from spec §19 (distinguished by sessionType).
// Phase 3 revision answers are bound to a RevisionSession via sessionId.
model SessionLog {
  id          String          @id @default(cuid())
  topicId     String
  topic       Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId   String
  session     RevisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sessionType    SessionType
  selectedAnswer String
  correct        Boolean?                                     // null for open-ended/self-assessed answers
  confidence     ConfidenceLevel                               // spec §11

  answeredAt  DateTime        @default(now())

  // Phase 4 — optional reverse link for auto Mistake provenance (SetNull on log delete).
  mistakeFromSource Mistake?

  @@unique([sessionId, questionId])
  @@index([topicId, answeredAt])
  @@index([answeredAt])
}

// Phase 3 — one topic-scoped revision attempt (OPEN → COMPLETED).
// At most one OPEN session per topic is enforced by a partial unique index
// in the migration SQL (Prisma cannot express partial unique indexes).
model RevisionSession {
  id                        String                 @id @default(cuid())
  topicId                   String
  topic                     Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  status                    RevisionSessionStatus  @default(OPEN)
  startedAt                 DateTime               @default(now())
  completedAt               DateTime?

  outcome                   RevisionSessionOutcome?
  previousIntervalDays      Int?
  resultingIntervalDays     Int?
  previousNextRevisionDate  DateTime?
  resultingNextRevisionDate DateTime?
  policyVersion             String                 @default("phase3-g5-v1")

  questions                 RevisionSessionQuestion[]
  logs                      SessionLog[]
  mistakes                  Mistake[]

  @@index([topicId, status])
  @@index([startedAt])
}

// Frozen REVISION question membership + order for a session (Decision B).
model RevisionSessionQuestion {
  id         String          @id @default(cuid())
  sessionId  String
  session    RevisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  sortOrder  Int

  @@unique([sessionId, questionId])
  @@unique([sessionId, sortOrder])
  @@index([questionId])
}

// Spec §15 — Mistake Log
// Phase 4 provenance: nullable FKs + unique sourceSessionLogId for auto-dedupe.
// Manual mistakes omit sourceSessionLogId (Postgres UNIQUE allows many NULLs).
model Mistake {
  id                   String   @id @default(cuid())
  topicId              String
  topic                Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  questionId           String?
  question             Question?        @relation(fields: [questionId], references: [id], onDelete: SetNull)
  sessionId            String?
  session              RevisionSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sourceSessionLogId   String?          @unique
  sourceSessionLog     SessionLog?      @relation(fields: [sourceSessionLogId], references: [id], onDelete: SetNull)

  mistakeText          String                              // what was misunderstood
  correctUnderstanding String                              // the correction
  turnedIntoQuestion   Boolean  @default(false)             // spec §15 — mistakes can become future questions
  resolvedAt           DateTime?                            // soft resolve; null = unresolved

  createdAt            DateTime @default(now())

  @@index([topicId])
  @@index([topicId, resolvedAt])
}

// Spec §12 — Deep Dive Queue. One active note-set per topic.
model DeepDiveNote {
  id        String   @id @default(cuid())
  topicId   String   @unique
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  reason    String                                          // why it needs deeper study
  notes     String?                                         // user's own notes/resources

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Spec §8, §19 — powers the dashboard's daily progress bar
model DailyProgress {
  id                String   @id @default(cuid())
  date              DateTime @unique @db.Date
  questionsAnswered Int      @default(0)
  questionsPlanned  Int      @default(0)

  @@index([date])
}
