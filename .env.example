# Database connection (Neon PostgreSQL pooled connection URL)
DATABASE_URL="postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# API authentication (single bearer token for local and deployed requests)
BEARER_TOKEN="change-this-to-your-local-secret-bearer-token"

# Optional: dedicated database URL for running integration tests against a test database
# DATABASE_URL_TEST="postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb_test?sslmode=require"
