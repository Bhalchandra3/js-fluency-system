# ==============================================================================
# JavaScript Fluency System — Environment Configuration Template (.env.example)
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit real credentials or production URLs to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Neon PostgreSQL Pooled Connection URL)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# Point this to your Neon branch named **dev** (pooled connection string from
# Neon Console → Connect → Branch = dev).
# Both Prisma CLI and local 'vercel dev' will read this single file (.env).
# Do NOT use the Neon **production** branch URL here.
DATABASE_URL="postgresql://user:password@ep-sample-dev-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# PRODUCTION (configured in Vercel → Settings → Environment Variables):
# Vercel **Production** must use the Neon branch named **production** only.
# Vercel Preview / Development should use Neon **dev** (same as local).
# Never point Vercel Production and local .env at the same Neon branch.
# Example production placeholder (do not commit real secrets):
# DATABASE_URL="postgresql://user:password@ep-sample-production-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. API Authentication (Single Pre-shared Bearer Token)
# ------------------------------------------------------------------------------
# Required for all authenticated /api/* endpoints.
# Set this to your local secret token for testing with Postman or browser /setup:
BEARER_TOKEN="change-this-to-your-local-secret-bearer-token"

# ------------------------------------------------------------------------------
# 3. Optional: Dedicated Disposable Database for Local Integration Test Suites
# ------------------------------------------------------------------------------
# Used only by 'npm run test:revision-write' and 'npm run test:revision-db'.
# Must point to a local disposable PostgreSQL instance (refuses neon.tech hosts):
# DATABASE_URL_TEST="postgresql://postgres:postgres@127.0.0.1:5432/jsfluency_test"
